    "@types/js-cookie": "^2.2.6",
    "@types/node": "^22.10.7",
    "@types/react": "^17.0.3",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^7.14.0",
    "jsdom": "^24.0.0",
    "react": "^16.9.0",
    "react-dom": "^16.9.0",
    "ts-standard": "^10.0.0",
    "tslib": "^2.1.0",
    "tsup": "^8.0.2",
    "typescript": "^4.9.5",
    "vitest": "^1.3.1"
